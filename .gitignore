rust-project.json
.elixir_ls/
.lexical/
.expert/
.elixir-tools/

# AI assistants and agent harnesses.
#
# **AGENTS.md is the brief, for every tool**, and CLAUDE.md only imports it.
# Per-tool instruction files and config directories would hold a second
# copy of the rules that drifts away from the first, so they stay out. Point
# your tool at AGENTS.md instead. A tool's own caches, histories, worktrees
# and local settings are personal and stay out too.
.claude/
CLAUDE.local.md
.cursor/
.cursorrules
.cursorignore
.cursorindexingignore
.windsurf/
.windsurfrules
.codeium/
.continue/
.aider*
CONVENTIONS.md
.gemini/
GEMINI.md
.codex/
.cline/
.clinerules
.roo/
.roomodes
.kiro/
.junie/
.amazonq/
.opencode/
.goose/
.goosehints
.zencoder/
.tabnine/
.copilot/
.augment/
.trae/
.qodo/
.specstory/
.crush/
.serena/
.mcp.json

# Version managers. mise.toml is the pin; a personal override or a second
# pin file in another format would quietly disagree with it.
mise.local.toml
.mise.local.toml
.tool-versions
.rust-toolchain.toml
rust-toolchain.toml
rust-toolchain

