# Rust / Cargo
target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed: CI builds with --locked, and the CLI, the GUI and
# the bindings all want a reproducible dependency graph. The determinism
# contract depends on it too, because `noise` produces part of our output.

# Elixir / Erlang
_build/
deps/
doc/
erl_crash.dump
*.ez
*.beam
terrain_generator-*.tar

# Java
java/out/
*.class
hs_err_pid*.log
replay_pid*.log

# Generated maps: the CLI and the GUI write them to the working directory.
# The pictures in docs/ are content and stay tracked.
*.png
!docs/*.png
!docs/options/*.png

# Profiling / tracing output
*.folded
perf.data*
flamegraph.svg
callgrind.out.*
*.profraw
*.profdata

# ---------------------------------------------------------------------------
# Personal tooling. Everything below is something a contributor's editor, OS
# or assistant writes into the tree, which ends up in a commit when someone
# runs `git add .` without looking. None of it is project content.
# ---------------------------------------------------------------------------

# JetBrains (RustRover, IntelliJ, CLion)
.idea/
*.iml
*.ipr
*.iws
.fleet/

# VS Code and its forks (Cursor, Windsurf, VSCodium)
.vscode/
*.code-workspace
.history/
.lh/

# Visual Studio
.vs/

# Eclipse and NetBeans, for the Java side
.project
.classpath
.settings/
.metadata/
.factorypath
nbproject/

# Vim, Emacs, Kate, Sublime, Zed, Helix, Nova
*.swp
*.swo
*~
\#*\#
.\#*
.*.kate-swp
*.sublime-project
*.sublime-workspace
.zed/
.helix/
.nova/

